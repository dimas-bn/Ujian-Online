# Salin file ini menjadi .env.local, lalu isi dengan kredensial project Supabase kamu
# (Supabase Dashboard > Project Settings > API)

NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=isi-anon-key-di-sini

# Hanya dipakai di server (API routes), JANGAN pernah di-expose ke client/browser
SUPABASE_SERVICE_ROLE_KEY=isi-service-role-key-di-sini
